# Server only. Copy to .env and fill. Never prefix with VITE_.
# .env is gitignored. These names are the only contract.
# Der Server liest sie selbst. Kein Python, kein VITE_-Prefix, nichts davon in den Browser.

XAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Leer oder auto: erster gesetzter Schlüssel, Reihenfolge xAI, Gemini, Groq, OpenRouter.
# Sonst genau einer: xai | gemini | groq | openrouter
TEXT_ANBIETER=

# Optional, sonst die Vorgabe im Code.
# XAI_MODEL=
# GEMINI_MODEL=
# GROQ_MODEL=
# OPENROUTER_MODEL=
